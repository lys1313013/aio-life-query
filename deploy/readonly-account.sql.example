-- 部署者在目标库执行；替换数据库名、连接来源与随机密码，只授权已发布数据集和分类关系使用的列。
CREATE ROLE aio_query_read LOGIN PASSWORD 'REPLACE_WITH_RANDOM_PASSWORD';
GRANT USAGE ON SCHEMA public TO aio_query_read;
ALTER ROLE aio_query_read SET default_transaction_read_only=on;
ALTER ROLE aio_query_read SET statement_timeout='5s';
GRANT SELECT (id, date, category_id, duration_minutes, create_user, start_minute, end_minute, title, description, is_manual, create_time, update_user, update_time, relate_id, relate_type, user_id, is_deleted)
  ON public.time_record TO aio_query_read;
GRANT SELECT (id, exercise_date, exercise_type_id, exercise_count, description, create_user, create_time, update_time, update_user, time_id, user_id, is_deleted)
  ON public.exercise_record TO aio_query_read;
GRANT SELECT (id, title, type, author, url, status, total_progress, current_progress, start_time, finish_time, create_time, remark, update_time, create_user, update_user, file_id, user_id, is_deleted)
  ON public.read_record TO aio_query_read;
GRANT SELECT (id, title, type, director, url, status, total_progress, current_progress, start_time, finish_time, rating, create_time, remark, update_time, create_user, update_user, file_id, user_id, is_deleted)
  ON public.movie TO aio_query_read;
GRANT SELECT (id, title, url, bvid, owner_name, duration_seconds, watched_duration_seconds, episodes, current_episode, status, last_watched, create_time, cover, notes, aid, description, pages_info, create_user, update_user, update_time, cover_file_id, cover_state, cover_version, user_id, is_deleted)
  ON public.b_video TO aio_query_read;
GRANT SELECT (id, performance_name, performer, performance_type, performance_date, city, venue, ticket_price, duration_minutes, rating, seat_info, review, purchase_platform, order_number, create_user, create_time, update_user, update_time, user_id, is_deleted)
  ON public.performance TO aio_query_read;
GRANT SELECT (id, user_id, template_id, name, is_deleted)
  ON public.time_tracker_category TO aio_query_read;
-- 升级现有只读账号时，只执行上面的 GRANT；先核对业务表和分类表的字段结构。

-- 月收入模型仅需要这些源列，不授予额外表或写入权限。
GRANT SELECT (user_id, inc_type_id, inc_date, amt, is_deleted)
  ON public.income TO aio_query_read;

-- 运动和月收入类型名称关系；保留公共、私有及个人覆盖的有效名称，排除已删除项。
GRANT SELECT (id, user_id, template_id, dict_type, dict_label, is_readonly, is_deleted)
  ON public.user_dict_data TO aio_query_read;
