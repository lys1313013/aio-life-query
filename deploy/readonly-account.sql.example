-- 部署者在目标库执行；替换数据库名、连接来源与随机密码，只授权已发布数据集和分类关系使用的列。
CREATE USER 'aio_query_read'@'CONNECTOR_HOST' IDENTIFIED BY 'REPLACE_WITH_RANDOM_PASSWORD';
GRANT SELECT (id, date, category_id, duration, create_user, start_time, end_time, title, description, is_manual, create_time, update_user, update_time, relate_id, relate_type, user_id, is_deleted)
  ON aio_life.time_record TO 'aio_query_read'@'CONNECTOR_HOST';
GRANT SELECT (id, exercise_date, exercise_type_id, exercise_count, description, create_user, create_time, update_time, update_user, time_id, user_id, is_deleted)
  ON aio_life.exercise_record TO 'aio_query_read'@'CONNECTOR_HOST';
GRANT SELECT (id, title, type, author, url, status, total_progress, current_progress, start_time, finish_time, create_time, remark, update_time, create_user, update_user, file_id, user_id, is_deleted)
  ON aio_life.read_record TO 'aio_query_read'@'CONNECTOR_HOST';
GRANT SELECT (id, title, type, director, url, status, total_progress, current_progress, start_time, finish_time, rating, create_time, remark, update_time, create_user, update_user, file_id, user_id, is_deleted)
  ON aio_life.movie TO 'aio_query_read'@'CONNECTOR_HOST';
GRANT SELECT (id, title, url, bvid, owner_name, duration, watched_duration, episodes, current_episode, status, last_watched, create_time, cover, notes, aid, description, pages_info, create_user, update_user, update_time, cover_file_id, cover_state, cover_version, user_id, is_deleted)
  ON aio_life.b_video TO 'aio_query_read'@'CONNECTOR_HOST';
GRANT SELECT (id, performance_name, performer, performance_type, performance_date, city, venue, ticket_price, duration, rating, seat_info, review, purchase_platform, order_number, create_user, create_time, update_user, update_time, user_id, is_deleted)
  ON aio_life.performance TO 'aio_query_read'@'CONNECTOR_HOST';
GRANT SELECT (id, user_id, template_id, name, is_deleted)
  ON aio_life.time_tracker_category TO 'aio_query_read'@'CONNECTOR_HOST';
-- 升级现有只读账号时，只执行上面的 GRANT；先核对业务表和分类表的字段结构。
